# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database ---
# Local PostgreSQL:  postgresql://postgres:yourpassword@localhost:5432/devicetrust
# Supabase: Project Settings > Database > Connection string > "Session pooler" (works on IPv4 networks)
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devicetrust
# Set to true for Supabase
DATABASE_SSL=false
# Separate database used only by `npm test` (tests wipe it)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devicetrust_test

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=30

# Admin dashboard origin(s), comma separated
CORS_ORIGINS=http://localhost:5173

# --- File storage ---
# local    = files saved in backend/uploads (development)
# supabase = private Supabase Storage bucket (production)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# URL the phone/emulator uses to reach this server (Android emulator: http://10.0.2.2:4000)
PUBLIC_BASE_URL=http://10.0.2.2:4000

# Only needed when STORAGE_DRIVER=supabase. Service role key stays on the server ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=devicetrust-private
